# Backend environment for LOCAL PERFORMANCE TESTING (docs/PERFORMANCE.md). Copy to .env.perf (git-ignored) and fill
# the two secrets. The perf npm scripts load ONLY this file (DOTENV_CONFIG_PATH=.env.perf), so nothing from .env (the
# remote database, SMTP, bKash, Google, AI credentials) is ever read by the perf stack.
#
#   cp .env.perf.example .env.perf
#   sed -i "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$(openssl rand -base64 48)|" .env.perf
#   sed -i "s|^DOCUMENT_ENCRYPTION_KEY=.*|DOCUMENT_ENCRYPTION_KEY=$(openssl rand -base64 32)|" .env.perf

NODE_ENV=development
# Not 4000: the everyday dev API keeps that port.
PORT=4100

# docker-compose.perf.yml (127.0.0.1 only, throwaway password)
DATABASE_URL=postgresql://fixeditnow:perfpassword@127.0.0.1:5455/fixeditnow_perf
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# The perf web app (frontend: npm run start:perf) runs on 3100 and proxies /api/v1/* here.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-48
BETTER_AUTH_URL=http://localhost:3100
FRONTEND_ORIGIN=http://localhost:3100
# The dev-mode perf web app (frontend: npm run dev:perf) on 3101 may also sign in and submit forms.
EXTRA_TRUSTED_ORIGINS=http://localhost:3101

# Mail is printed to this terminal; no SMTP, Google, bKash or AI service is configured.
MAIL_TRANSPORT=console
EMAIL_FROM="FixedItNow Perf <no-reply@localhost>"

TRUST_PROXY=1
# Off so a load test from one machine measures the API, not the 429 responses of the per-IP limiter.
RATE_LIMIT_ENABLED=false

# Optional (worker identity documents). Base64 of 32 random bytes.
DOCUMENT_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
DOCUMENT_ENCRYPTION_KEY_ID=perf1

# One JSON access-log line per request, with its duration.
HTTP_LOG=true
